;;;; -*- Hen -*-

(
 ; Your egg's license:
 (license "MIT")

 ; Egg category
 (category data)

 ; A list of eggs llama depends on.
 (dependencies srfi-1 srfi-69
               vector-lib blas random-mtzig
               endian-sequence endian-port getopt-long yasos
               datatype array-morphisms array-morphisms-crunch
               )

 (author "Ivan Raikov")

 (synopsis "Inference with Llama2 model.")

 (components (extension llama-common
                        (source "llama-common.scm")
                        (csc-options "-O3" "-d1"))
             (extension llama
                        (source "llama.scm")
                        (csc-options "-O3" "-d1")
                        (component-dependencies llama-common))
             (extension llama-am
                        (source "llama-am.scm")
                        (csc-options "-O3" "-d1")
                        (component-dependencies llama-common))
             (program llama-cli
                      (source "llama-cli.scm")
                      (csc-options -local -O3 -d0 -block)
                      (component-dependencies
                       llama-common llama llama-am)))

 (test-dependencies test)

)
